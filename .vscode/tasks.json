{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Lint FIFO RTL",
        "type": "shell",
        "command": "verilator",
        "args": [
          "--lint-only",
          "-Wall",
          "--top-module",
          "sync_fifo",
          "rtl/sync_fifo.sv"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": []
      }
    ]
  }
  